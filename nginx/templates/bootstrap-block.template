# Bootstrap config — used only for the first run, BEFORE a certificate
# exists. An HTTPS server block referencing /etc/letsencrypt/live/... would
# make nginx refuse to start if those files don't exist yet, so this stays
# HTTP-only just long enough for certbot to complete its webroot challenge.
# Rendered by scripts/generate-conf.sh from every domain in DOMAIN_MAP — see
# scripts/init-letsencrypt.sh, which swaps this out for the real per-domain
# config afterwards.
#
# All domains proxy to the first DOMAIN_MAP entry's app here temporarily —
# doesn't matter which app answers during the challenge, only that the
# acme-challenge path is served and the domain names are recognized.
server {
    listen 80;
    server_name ${ALL_DOMAINS};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://${FIRST_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
