PROXY_NETWORK_NAME=proxy
EMAIL=example@example.com

# Domain -> upstream container mapping, ";"-separated "domain=host:port"
# entries. scripts/generate-conf.sh renders both the certbot -d flags and
# the nginx server blocks from this — to add an app, add one entry here and
# run scripts/expand-cert.sh (or init-letsencrypt.sh on the first run).
# nginx/templates/*.template and docker-compose.yml never need to change.
# All domains share one multi-SAN cert named after the FIRST entry here.
DOMAIN_MAP="example.com=container:3000;www.example.com=container:3000;sub.example.com=sub-container:3000"
